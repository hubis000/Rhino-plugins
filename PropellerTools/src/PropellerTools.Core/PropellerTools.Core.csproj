<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>

    <AssemblyName>PropellerTools.Core</AssemblyName>
    <RootNamespace>PropellerTools.Core</RootNamespace>

    <!-- Rhino resolves this assembly by simple name and version. The .rhp has a hard
         binding reference to 1.0.0.0, so do not bump AssemblyVersion without rebuilding
         both plugins - a version mismatch gives the same FileNotFoundException as a
         missing file. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>

    <Company>Mejzlik Propellers s.r.o.</Company>
    <Product>PropellerTools</Product>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- RhinoCommon is used for geometry types only. ExcludeAssets="runtime" stops
         RhinoCommon.dll being copied to the output; Rhino supplies it at load time and a
         stray copy alongside the .rhp can shadow the host version. -->
    <PackageReference Include="RhinoCommon" Version="7.13.21348.13001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
