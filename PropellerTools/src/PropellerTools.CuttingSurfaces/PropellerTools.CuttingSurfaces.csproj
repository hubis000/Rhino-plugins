<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>

    <AssemblyName>PropellerToolsCuttingSurfaces</AssemblyName>
    <RootNamespace>PropellerTools.CuttingSurfaces</RootNamespace>
    <TargetExt>.rhp</TargetExt>

    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>

    <Company>Mejzlik Propellers s.r.o.</Company>
    <Product>PropellerTools Cutting Surfaces</Product>
    <Description>Open upper/lower cutting surfaces for roving pockets.</Description>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplies the .NET Framework 4.8 reference assemblies, so `dotnet build` can
         target net48 without Visual Studio or a targeting-pack installer.
         PrivateAssets="all" keeps it out of the build output. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="7.13.21348.13001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shares the SAME Core project as the main plugin. Do not fork the solver. -->
    <ProjectReference Include="..\PropellerTools.Core\PropellerTools.Core.csproj" Private="true" />
  </ItemGroup>

</Project>
